# このファイルは見本。コピーして .streamlit/secrets.toml を作り、自分の値を入れる。
# .streamlit/secrets.toml は .gitignore 済み。値を git・チャット・AI に渡さないこと。
# Community Cloud では、アプリの Settings > Secrets に同じ 3 行を貼る。

SUPABASE_URL = "<Supabase の Project URL>"
SUPABASE_SERVICE_KEY = "<サーバ専用の秘密鍵（service_role 相当）>"
APP_PASSWORD = "<自分で決めた 16 文字以上のパスワード>"
